# Supabase > Project Settings > Database > Connection string
# "Transaction pooler" (port 6543) — used by the website
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30"
# "Session pooler" or direct connection (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?connect_timeout=30"

# Supabase > Project Settings > API. The service role key is secret: server only, never NEXT_PUBLIC_.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

ADMIN_PASSWORD="change-me-123"
SESSION_SECRET="replace-this-with-a-long-random-string"
