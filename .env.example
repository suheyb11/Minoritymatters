# MySQL on Hostinger (hPanel > Databases > MySQL Databases). See HOSTINGER.md.
# On the Hostinger server the host is "localhost". From your computer use the Remote MySQL host
# (hPanel > Databases > Remote MySQL), e.g. srv1234.hstgr.io, and allow your IP address there.
# A password with special characters (@ : / # ?) must be URL-encoded, e.g. @ -> %40
DATABASE_URL="mysql://u123456789_mm:YOUR-DB-PASSWORD@localhost:3306/u123456789_mm"

# Where files uploaded in the admin are kept (images and reply attachments). See lib/storage.ts.
# On Hostinger: a folder OUTSIDE the app folder, so a new deploy does not delete it.
# Empty = the "storage" folder of the project (on your computer).
STORAGE_DIR=""

# The website address (no / at the end)
SITE_URL="https://minoritymatters.org.uk"

ADMIN_PASSWORD="change-me-123"
# Optional: the email the Administrator logs in with. Empty = only the password counts.
ADMIN_EMAIL=""
SESSION_SECRET="replace-this-with-a-long-random-string"

# Optional: email the charity when someone books a place on an event (resend.com).
# Leave empty to switch this off; bookings are always saved in Admin > Events either way.
RESEND_API_KEY=""
BOOKING_NOTIFY_EMAIL=""
# The sender address (must be a domain verified in Resend). Empty = Resend's test sender.
BOOKING_FROM_EMAIL=""

# ---------- Only for moving the data out of Supabase (npm run data:from-supabase, once) ----------
# The old Supabase DATABASE_URL (Transaction pooler, port 6543)
SUPABASE_DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
