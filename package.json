{
  "name": "minority-matters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "data:export": "tsx --env-file=.env scripts/export-data.ts",
    "data:import": "tsx --env-file=.env scripts/import-data.ts",
    "data:for-wordpress": "tsx scripts/export-for-wordpress.ts",
    "db:deploy": "prisma migrate deploy",
    "data:from-supabase": "prisma generate --schema prisma/supabase.prisma && tsx --env-file=.env scripts/export-from-supabase.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.3",
    "framer-motion": "^14.2.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.14.1",
    "next": "15.5.28",
    "nodemailer": "^10.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.6"
    }
  }
}
