// The database schema for the website. The database is Supabase (PostgreSQL).
// DATABASE_URL = Supabase "Transaction pooler" (port 6543), used by the website.
// DIRECT_URL   = Supabase "Session pooler" or direct connection (port 5432), used by prisma migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Site-wide text and contact details. There is only one row (id = 1).
model Setting {
  id            Int    @id @default(1)
  heroTagline   String @default("")
  introHeading  String @default("")
  introSubtitle String @default("")
  introText     String @default("")
  address       String @default("")
  phone         String @default("")
  email         String @default("")
  pressEmail    String @default("")
  charityNumber String @default("")
  donateUrl     String @default("")
  tiktokUrl     String @default("")
  xUrl          String @default("")
  facebookUrl   String @default("")
  youtubeUrl    String @default("")
  instagramUrl  String @default("")
  linkedinUrl   String @default("")
  aboutLead     String @default("")
  aboutStory    String @default("")
  vision        String @default("")
  mission       String @default("")
  // Text from the brochure
  whoWeAre      String @default("")
  referralText  String @default("")
  tagline       String @default("")
  communityLine String @default("")
  // The "Our founder" video page (/our-founder)
  founderName       String @default("")
  founderRole       String @default("")
  founderPhoto      String @default("") // also the picture shown before the video plays
  founderVideoUrl   String @default("") // YouTube, Vimeo or .mp4 link
  founderIntro      String @default("")
  founderTranscript String @default("") // lines starting with [mm:ss] show a time
}

// "Our work": the 5 main service areas and the named programmes
model Service {
  id        Int     @id @default(autoincrement())
  title     String
  slug      String  @unique
  summary   String  @default("")
  intro     String  @default("")
  points    String  @default("") // one bullet per line
  outro     String  @default("") // paragraphs separated by a blank line
  icon      String  @default("/images/icons/promotion.svg")
  sortOrder Int     @default(0)
  published Boolean @default(true)
  kind      String  @default("programme") // "area" = one of the 5 main service areas, "programme" = a named programme
}

// "Impact": the projects we delivered, grouped by period (for example "2025–26")
model Project {
  id             Int     @id @default(autoincrement())
  title          String
  slug           String  @unique
  period         String  @default("") // for example "2025–26"
  category       String  @default("") // one of PROJECT_CATEGORIES in lib/db.ts
  summary        String  @default("") // 1–2 sentences
  body           String  @default("") // paragraphs separated by a blank line
  stats          String  @default("") // one per line: "number|label", e.g. "93|boys aged 11–16"
  peopleReached  Int     @default(0) // 0 = not counted in the total
  coverImage     String  @default("")
  gallery        String  @default("") // one image per line: "path" or "path | description"
  relatedService String  @default("") // a Service slug, or ""
  sortOrder      Int     @default(0)
  published      Boolean @default(true)
  // The one project shown as "Featured story" on the home page (only one at a time)
  isFeatured       Boolean @default(false)
  featuredHeadline String  @default("") // optional; the project title is used when empty
}

model Value {
  id        Int    @id @default(autoincrement())
  title     String
  text      String @default("")
  icon      String @default("")
  sortOrder Int    @default(0)
}

model PressItem {
  id        Int    @id @default(autoincrement())
  title     String
  source    String @default("")
  url       String
  image     String @default("")
  sortOrder Int    @default(0)
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  body        String   @default("") // paragraphs separated by a blank line
  coverImage  String   @default("")
  author      String   @default("Minority Matters")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
}

model Funder {
  id        Int     @id @default(autoincrement())
  name      String
  logo      String  @default("")
  url       String  @default("")
  showLogo  Boolean @default(false) // show the logo on the home page
  sortOrder Int     @default(0)
}

// Contact form messages
model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  message   String
  reason    String   @default("General enquiry") // one of the choices in lib/reasons.ts
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// "Events": activities, trips and sessions people can come to (/events)
model Event {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  summary         String    @default("") // 1–2 sentences for cards
  body            String    @default("") // paragraphs separated by a blank line
  startsAt        DateTime
  endsAt          DateTime?
  location        String    @default("") // e.g. "Sobell Leisure Centre"
  address         String    @default("") // full address incl. postcode
  audience        String    @default("Everyone") // one of EVENT_AUDIENCES in lib/db.ts
  ageMin          Int?
  ageMax          Int?
  price           String    @default("Free") // free text: "Free", "£2 per child"
  capacity        Int? // null = unlimited
  bookingType     String    @default("form") // "form" | "external" | "none"
  bookingUrl      String    @default("") // Plinth / Eventbrite / Google Form link when external
  bookingClosesAt DateTime?
  coverImage      String    @default("")
  projectSlug     String    @default("") // link to an Impact project (optional)
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  bookings        Booking[]
}

// Places booked through the form on an event page. Never shown on public pages (only counts).
model Booking {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // parent/guardian or adult attendee
  email     String
  phone     String   @default("")
  adults    Int      @default(1)
  children  Int      @default(0)
  childAges String   @default("") // e.g. "8, 11"
  notes     String   @default("") // access needs or questions (optional)
  status    String   @default("confirmed") // "confirmed" | "waitlist" | "cancelled" | "attended"
  createdAt DateTime @default(now())

  @@index([eventId])
}
