// THE OLD SUPABASE SCHEMA (PostgreSQL). Only used by scripts/export-from-supabase.ts to copy the data to MySQL.
// SUPABASE_DATABASE_URL = the old Supabase DATABASE_URL (Transaction pooler, port 6543).

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/supabase-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
}

// Site-wide text and contact details. There is only one row (id = 1).
model Setting {
  id            Int    @id @default(1)
  heroTagline   String @default("")
  introHeading  String @default("")
  introSubtitle String @default("")
  introText     String @default("")
  address       String @default("")
  phone         String @default("")
  email         String @default("")
  pressEmail    String @default("")
  charityNumber String @default("")
  donateUrl     String @default("")
  tiktokUrl     String @default("")
  xUrl          String @default("")
  facebookUrl   String @default("")
  youtubeUrl    String @default("")
  instagramUrl  String @default("")
  linkedinUrl   String @default("")
  aboutLead     String @default("")
  aboutStory    String @default("")
  vision        String @default("")
  mission       String @default("")
  // Text from the brochure
  whoWeAre      String @default("")
  referralText  String @default("")
  tagline       String @default("")
  communityLine String @default("")
  // The "Our founder" video page (/our-founder)
  founderName       String @default("")
  founderRole       String @default("")
  founderPhoto      String @default("") // also the picture shown before the video plays
  founderVideoUrl   String @default("") // YouTube, Vimeo or .mp4 link
  founderIntro      String @default("")
  founderTranscript String @default("") // lines starting with [mm:ss] show a time
  // A copy of every contact form message is emailed here. Empty = no emails (messages are always saved)
  contactNotifyEmail String @default("")
  // We email this address when someone books a place on an event. Empty = BOOKING_NOTIFY_EMAIL in .env, or no emails
  bookingNotifyEmail String @default("")
  // The second way to donate. With both donate links filled in, the Donate buttons let people choose (/donate)
  donateGiveyUrl     String @default("")
}

// "Our work": the 5 main service areas and the named programmes
model Service {
  id        Int     @id @default(autoincrement())
  title     String
  slug      String  @unique
  summary   String  @default("")
  intro     String  @default("")
  points    String  @default("") // one bullet per line
  outro     String  @default("") // paragraphs separated by a blank line
  icon      String  @default("/images/icons/promotion.svg")
  sortOrder Int     @default(0)
  published Boolean @default(true)
  kind      String  @default("programme") // "area" = one of the 5 main service areas, "programme" = a named programme
}

// "Impact": the projects we delivered, grouped by period (for example "2025–26")
model Project {
  id             Int     @id @default(autoincrement())
  title          String
  slug           String  @unique
  period         String  @default("") // for example "2025–26"
  category       String  @default("") // one of PROJECT_CATEGORIES in lib/db.ts
  summary        String  @default("") // 1–2 sentences
  body           String  @default("") // paragraphs separated by a blank line
  stats          String  @default("") // one per line: "number|label", e.g. "93|boys aged 11–16"
  peopleReached  Int     @default(0) // 0 = not counted in the total
  coverImage     String  @default("")
  gallery        String  @default("") // one image per line: "path" or "path | description"
  relatedService String  @default("") // a Service slug, or ""
  sortOrder      Int     @default(0)
  published      Boolean @default(true)
  // The one project shown as "Featured story" on the home page (only one at a time)
  isFeatured       Boolean @default(false)
  featuredHeadline String  @default("") // optional; the project title is used when empty
}

model Value {
  id        Int    @id @default(autoincrement())
  title     String
  text      String @default("")
  icon      String @default("")
  sortOrder Int    @default(0)
}

model PressItem {
  id        Int    @id @default(autoincrement())
  title     String
  source    String @default("")
  url       String
  image     String @default("")
  sortOrder Int    @default(0)
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  body        String   @default("") // paragraphs separated by a blank line
  coverImage  String   @default("")
  author      String   @default("Minority Matters")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
}

model Funder {
  id        Int     @id @default(autoincrement())
  name      String
  logo      String  @default("")
  url       String  @default("")
  showLogo  Boolean @default(false) // show the logo on the home page
  sortOrder Int     @default(0)
}

// Contact form messages, and email answers copied from the mailbox (reason "Email reply", see lib/conversations.ts)
model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  message   String
  reason    String   @default("General enquiry") // one of the choices in lib/reasons.ts, or "Email reply"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  subject   String   @default("") // email answers only
  messageId String   @default("") // email answers only: the email's Message-ID, so it is copied once

  @@index([email])
}

// Replies sent from Admin > Messages. Grouped with the messages by email address (one conversation per person).
model Reply {
  id         Int      @id @default(autoincrement())
  email      String // the person the reply was sent to (lower case)
  subject    String
  body       String
  files      Json     @default("[]") // [{ name, path, size }]: files in the private Storage bucket "attachments"
  sent       Boolean  @default(false) // false = saved, but the email could not be delivered
  authorName String   @default("")
  createdAt  DateTime @default(now())

  @@index([email])
}

// Website managers: they log in at /admin/login with their email and password.
// The Administrator is not in this table: they log in with ADMIN_PASSWORD (.env), see lib/auth.ts.
model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique // lower case
  passwordHash String
  createdAt    DateTime @default(now())
}

// How the website sends email (Admin > Site settings > Email sending). There is only one row (id = 1).
model MailConfig {
  id          Int       @id @default(1)
  user        String    @default("") // the Google account, e.g. info@minoritymatters.org.uk
  fromAddress String    @default("") // optional "Send as" address (an alias of the account)
  pass        String    @default("") // the App password, encrypted (lib/mail.ts)
  host        String    @default("smtp.gmail.com")
  port        Int       @default(587)
  lastError   String    @default("") // the last sending error, shown in the admin
  imapError   String    @default("") // the last error while checking the mailbox for email answers
  lastSyncAt  DateTime? // when the mailbox was last checked
  seen        String    @default("") // emails already looked at, one "folder:uid" per line (the last 5000)
}

// Counts form uses per visitor (a hash of the IP address) for 10 minutes, so forms can't be flooded
model RateHit {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// "Events": activities, trips and sessions people can come to (/events)
model Event {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  summary         String    @default("") // 1–2 sentences for cards
  body            String    @default("") // paragraphs separated by a blank line
  startsAt        DateTime
  endsAt          DateTime?
  location        String    @default("") // e.g. "Sobell Leisure Centre"
  address         String    @default("") // full address incl. postcode
  audience        String    @default("Everyone") // one of EVENT_AUDIENCES in lib/db.ts
  ageMin          Int?
  ageMax          Int?
  price           String    @default("Free") // free text: "Free", "£2 per child"
  capacity        Int? // null = unlimited
  bookingType     String    @default("form") // "form" | "external" | "none"
  bookingUrl      String    @default("") // Plinth / Eventbrite / Google Form link when external
  bookingClosesAt DateTime?
  coverImage      String    @default("")
  projectSlug     String    @default("") // link to an Impact project (optional)
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  bookings        Booking[]
}

// Places booked through the form on an event page. Never shown on public pages (only counts).
model Booking {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // parent/guardian or adult attendee
  email     String
  phone     String   @default("")
  adults    Int      @default(1)
  children  Int      @default(0)
  childAges String   @default("") // e.g. "8, 11"
  notes     String   @default("") // access needs or questions (optional)
  status    String   @default("confirmed") // "confirmed" | "waitlist" | "cancelled" | "attended"
  createdAt DateTime @default(now())

  @@index([eventId])
}
